{
  "name": "commission-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/unit.test.js tests/api.test.js",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:e2e": "node tests/e2e.selenium.js",
    "test:all": "npm run lint && npm test && npm run test:api",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "express": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "selenium-webdriver": "^4.38.0"
  }
}